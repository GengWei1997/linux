# Device configuration fragment for the Xiaomi Redmi K20 Pro (raphael).
#
# This is a delta against arch/arm64/configs/defconfig, not a complete
# configuration.  Generate a .config from it in the source tree root with
#
#   make ARCH=arm64 defconfig
#   ./scripts/kconfig/merge_config.sh -m .config \
#       arch/arm64/configs/sm8150-xiaomi-raphael.config
#   make ARCH=arm64 olddefconfig
#
# Any base configuration works as long as it covers the generic arm64
# requirements; the fragment only adds what this board needs and removes the
# platforms it can never have.

# Versioning
CONFIG_LOCALVERSION="-raphael"
# CONFIG_LOCALVERSION_AUTO is not set

# Display: DRM+MSM and the EA8076 panel built in so the panel comes up early
# enough for the initramfs to take over.
CONFIG_DRM=y
CONFIG_DRM_CLIENT_LIB=y
CONFIG_DRM_CLIENT_SELECTION=y
CONFIG_DRM_DISPLAY_DP_AUX_BUS=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_EXEC=y
CONFIG_DRM_GPUVM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_SAMSUNG_EA8076=y
CONFIG_DRM_SCHED=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_CEC_CORE=y

# Touchscreen: Goodix GT9886 (GTx8 family)
# CONFIG_TOUCHSCREEN_GOODIX is not set
CONFIG_TOUCHSCREEN_GOODIX_GTX8=m
CONFIG_TOUCHSCREEN_GOODIX_GTX8_UPDATE=y
# CONFIG_TOUCHSCREEN_GOODIX_GTX8_GESTURE is not set
# CONFIG_TOUCHSCREEN_GOODIX_GTX8_TOOLS is not set

# USB gadget: the debug network interface and the serial console the
# initramfs and the installed system bring up through configfs.
CONFIG_USB_CONFIGFS=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_F_EEM=y
CONFIG_USB_F_FS=y
CONFIG_USB_F_MASS_STORAGE=y
CONFIG_USB_F_NCM=y
CONFIG_USB_F_OBEX=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_F_SERIAL=y
CONFIG_USB_F_SUBSET=y
CONFIG_USB_G_SERIAL=m
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_U_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y

# Charging: PM8150B SMB5 and the SMB1390 switch-cap charge pump
CONFIG_CHARGER_QCOM_PM8150B=m
CONFIG_CHARGER_QCOM_SMB1390=m

# RTC: the PM8xxx counter plus its SDAM-backed offset.  EFI GetTime is
# broken on this firmware, so the EFI RTC has to stay off; SDAM must be
# built in because hctosys runs long before modules can be loaded.
CONFIG_NVMEM_SPMI_SDAM=y
# CONFIG_RTC_DRV_EFI is not set
CONFIG_RTC_DRV_PM8XXX=y

# SoC interconnect / PHY / cache: built in, display and storage need them
# before the initramfs can mount anything.
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_UBWC_CONFIG=y
CONFIG_REGULATOR_QCOM_REFGEN=y

# Vibration: PM8150B haptics block driving the ERM actuator
CONFIG_INPUT_QCOM_PM8150B_HAPTICS=m

# Lockup detector: arm64 only offers the perf based hardlockup detector when
# pseudo-NMI is enabled, which is not the case here, so the perf probe fails
# with -ENODEV and the kernel reports the hard watchdog as permanently
# disabled.  The hrtimer "buddy" detector needs no such support and watches
# the CPUs for hard lockups from a high resolution timer instead.
CONFIG_HARDLOCKUP_DETECTOR=y

# Flash: the rear camera's flash is wired to the PM8150L flash LED block.
# The LED class driver provides the torch and flash nodes; the V4L2 layer is
# what a camera application talks to when it uses the flash as a strobe, and
# it is off in defconfig.
CONFIG_LEDS_CLASS_FLASH=m
CONFIG_LEDS_QCOM_FLASH=m
CONFIG_V4L2_FLASH_LED_CLASS=m

# Swap: zram must be built in, it is set up before modules from the rootfs
# can be loaded.  zstd is the default compressor chosen below, and the other
# backends are cheap to keep around.
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZ4HC=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_DEFLATE=y
CONFIG_ZRAM_BACKEND_842=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_DEF_COMP="zstd"

# Audio: the SM8150 machine driver and the TFA9874 speaker amplifier.  The
# SLIMbus, APR, WCD9340 and QDSP6 pieces the card depends on are already in
# defconfig.
CONFIG_SND_SOC_SM8150=m
CONFIG_SND_SOC_TFA9874=m

# Unrelated platforms: arm64 defconfig pulls in drivers for SoCs that do not
# exist on this phone.  Building them costs a lot of compile time and image
# space, and none of them can ever probe here, so turn them off the same way
# the other Qualcomm device kernels do.  nouveau alone is 700+ objects.
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_ETNAVIV is not set
# CONFIG_DRM_EXYNOS is not set
# CONFIG_DRM_FSL_LDB is not set
# CONFIG_DRM_HDLCD is not set
# CONFIG_DRM_HISI_HIBMC is not set
# CONFIG_DRM_HISI_KIRIN is not set
# CONFIG_DRM_IMX_DCSS is not set
# CONFIG_DRM_IMX_LCDIF is not set
# CONFIG_DRM_KOMEDA is not set
# CONFIG_DRM_LIMA is not set
# CONFIG_DRM_MALI_DISPLAY is not set
# CONFIG_DRM_MEDIATEK is not set
# CONFIG_DRM_MESON is not set
# CONFIG_DRM_MXS is not set
# CONFIG_DRM_MXSFB is not set
# CONFIG_DRM_PANFROST is not set
# CONFIG_DRM_PANTHOR is not set
# CONFIG_DRM_PL111 is not set
# CONFIG_DRM_POWERVR is not set
# CONFIG_DRM_RCAR_DU is not set
# CONFIG_DRM_ROCKCHIP is not set
# CONFIG_DRM_RZG2L_DU is not set
# CONFIG_DRM_STM is not set
# CONFIG_DRM_SUN4I is not set
# CONFIG_DRM_TEGRA is not set
# CONFIG_DRM_TIDSS is not set
# CONFIG_DRM_V3D is not set
# CONFIG_DRM_VC4 is not set
# CONFIG_DRM_ZYNQMP_DPSUB is not set
# CONFIG_MMC_UNIPHIER is not set
# CONFIG_MMC_SUNXI is not set
# CONFIG_MMC_MTK is not set
# CONFIG_USB_DWC3_EXYNOS is not set
# CONFIG_USB_DWC3_KEYSTONE is not set
# CONFIG_NET_VENDOR_FREESCALE is not set
# CONFIG_RTC_DRV_FSL_FTM_ALARM is not set
# CONFIG_RTC_DRV_SUN6I is not set

# Machine drivers for other SoCs, the Qualcomm ones stay enabled.
# CONFIG_SND_SOC_APPLE_MCA is not set
# CONFIG_SND_SOC_FSL_ASOC_CARD is not set
# CONFIG_SND_SOC_FSL_ASRC is not set
# CONFIG_SND_SOC_FSL_AUDMIX is not set
# CONFIG_SND_SOC_FSL_EASRC is not set
# CONFIG_SND_SOC_FSL_ESAI is not set
# CONFIG_SND_SOC_FSL_MICFIL is not set
# CONFIG_SND_SOC_FSL_SAI is not set
# CONFIG_SND_SOC_FSL_SPDIF is not set
# CONFIG_SND_SOC_FSL_SSI is not set
# CONFIG_SND_SOC_FSL_UTILS is not set
# CONFIG_SND_SOC_MEDIATEK is not set
# CONFIG_SND_SOC_MESON_T9015 is not set
# CONFIG_SND_SOC_ROCKCHIP_I2S is not set
# CONFIG_SND_SOC_ROCKCHIP_I2S_TDM is not set
# CONFIG_SND_SOC_ROCKCHIP_RT5645 is not set
# CONFIG_SND_SOC_ROCKCHIP_SAI is not set
# CONFIG_SND_SOC_ROCKCHIP_SPDIF is not set
# CONFIG_SND_SOC_SAMSUNG is not set
# CONFIG_SND_SOC_SOF is not set
# CONFIG_SND_SOC_SOF_TOPLEVEL is not set
# CONFIG_SND_SOC_TEGRA is not set
# CONFIG_SND_SOC_TEGRA_AUDIO_GRAPH_CARD is not set
# CONFIG_SND_SOC_TI_EDMA_PCM is not set
# CONFIG_SND_SOC_TI_SDMA_PCM is not set
# CONFIG_SND_SOC_TI_UDMA_PCM is not set
# CONFIG_SND_SOC_XILINX_AUDIO_FORMATTER is not set
# CONFIG_SND_SOC_XILINX_I2S is not set
# CONFIG_SND_SOC_XILINX_SPDIF is not set
